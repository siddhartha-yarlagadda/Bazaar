{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Launch API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/dist/server.js",
      "preLaunchTask": "Backend: Build",
      "outFiles": ["${workspaceFolder}/backend/dist/**/*.js"],
      "env": {
        "PORT": "3000"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
